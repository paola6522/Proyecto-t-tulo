# Entorno virtual
env/
venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs
*.log

# Configuración de IDE
.vscode/
.idea/

# Staticfiles generados por collectstatic
staticfiles/

# NO ignorar carpeta static creada por ti
!static/
!static/**

# Permitir carpeta ML completa
!biblioteca/ml/
!biblioteca/ml/*.pkl
!biblioteca/ml/*.joblib

# Pero NO permitir datasets gigantes
biblioteca/ml/*.csv

# Archivos que jamás deben subirse
*.sqlite3
*.db
*.DS_Store



